# Copy to .env and fill in. Never commit .env.
#
# Generate the secrets with:
#   openssl rand -hex 32          -> POSTGRES_PASSWORD, JWT_SECRET (min 32 chars)
# Then mint ANON_KEY / SERVICE_ROLE_KEY from JWT_SECRET at
#   https://supabase.com/docs/guides/self-hosting#api-keys
# (or with the jwt-gen script in scripts/, offline).

# Namespaces every container, network and volume this stack creates. Changing
# it is what guarantees `docker compose` cannot adopt or recreate a container
# belonging to something already on the server.
COMPOSE_PROJECT_NAME=artisthub

# Host ports. Run scripts/preflight.sh first: if it reports a port in use,
# change it HERE rather than stopping whatever is already using it.
# Bind to 127.0.0.1 so nothing new is exposed publicly — the existing web
# server proxies a subdomain to KONG_HTTP_PORT.
KONG_HTTP_PORT=8000
POSTGRES_PORT=5432
STUDIO_PORT=54321

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Public URL clients hit. Local dev: http://localhost:8000
# Production: https://api.yourdomain.com  (put a real domain + TLS in front of
# the server; do not ship a bare IP to a mobile app — you cannot get a cert for
# it, and App Transport Security on iOS will block plain http.)
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:5173

# Studio (the self-hosted admin DB UI) basic auth
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# --- Auth email (GoTrue) ---------------------------------------------------
# Phase 1 leaves signup auto-confirm ON so you can test without a mail provider.
# This MUST become false before real users exist, or anyone can sign up as any
# email address they do not own.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_EMAIL_SIGNUP=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Artist Hub
SMTP_ADMIN_EMAIL=
