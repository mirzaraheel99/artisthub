# Copy to .env. Expo inlines EXPO_PUBLIC_* vars into the JS bundle — the anon
# key is designed to be public, RLS is what protects the data.
#
# Note for real-device testing: localhost points at the phone, not your laptop.
# Use your machine's LAN IP (e.g. http://192.168.1.20:8000) or the server's
# domain. See docs/PHASE-1-TESTING.md.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=
